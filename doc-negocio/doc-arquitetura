# CustomerStatusListener.java

@Component
@RequiredArgsConstructor
public class CustomerStatusListener {

    private final ChangeCustomerStatusUseCase useCase;
    private final ProcessedMessageRepository processedMsgRepo; // Tabela para guardar eventId já processados

    @RabbitListener(queues = RabbitMQConfig.QUEUE_STATUS_CHANGE)
    @Transactional
    public void handleStatusChange(CustomerStatusChangeEvent event) {
        // Garantindo Idempotência
        if (processedMsgRepo.existsById(event.getEventId())) {
            log.info("Evento com ID {} já foi processado. Ignorando.", event.getEventId());
            return;
        }

        useCase.execute(event.getCustomerId(), event.getStatus());
        
        // Registrar ID do Evento Processado
        processedMsgRepo.save(new ProcessedMessage(event.getEventId(), LocalDateTime.now()));
    }
}

